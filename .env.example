# Local Environment Configuration Template
# Duplicate this file to .env and configure local credentials.

# Application Settings
APP_NAME="Graph-Based Cash-Flow Intelligence System"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Canonical Relational Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cashflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# For local testing or if PostgreSQL is not running:
# DATABASE_URL=sqlite:///./cashflow.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashflow_db

# Temporal Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Multi-Provider LLM Configuration (OpenRouter, Gemini, Hugging Face, OpenAI)
# Default provider can be: "openrouter", "gemini", "huggingface", "openai"
LLM_PROVIDER=openrouter

# OpenRouter (Free / Low-cost Models e.g. meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini API (Free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Hugging Face Inference API
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenAI API (Optional Fallback)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
